{{ template "base" . }}
{{ define "head" }}<style>
/* ── Video room layout ─────────────────────────────── */
#video-room-header {
  grid-column: 1 / 4;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1rem;
  background: #1a1a2e;
  border-bottom: 1px solid #2e2e50;
  flex-wrap: wrap;
}

#video-root {
  grid-column: 1 / 4;
  padding: 0 1rem;
  box-sizing: border-box;
}

#video-grid {
  display: grid;
  gap: 10px;
  width: 100%;
  grid-template-columns: 1fr;
}

#video-grid video {
  grid-column: unset;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: #000;
  border-radius: 6px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.6);
}

/* Each video sits in a tile carrying the person's name and, in a dice
   game, their score; the tile of whoever's turn it is glows. */
.video-tile {
  position: relative;
  border-radius: 6px;
}
.video-tile video { display: block; }
.tile-label,
.tile-badge {
  position: absolute;
  top: 0.4rem;
  padding: 0.15em 0.55em;
  border-radius: 4px;
  background: rgba(10, 10, 25, 0.72);
  color: #e8e8ff;
  font-size: 0.85rem;
  pointer-events: none;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tile-label { left: 0.4rem; }
.tile-badge {
  right: 0.4rem;
  display: none;
  font-family: monospace;
  color: #ffe15a;
}
.video-tile.has-badge .tile-badge { display: block; }
.video-tile.turn {
  outline: 3px solid #ffd84a;
  box-shadow: 0 0 18px 4px rgba(255, 216, 74, 0.55);
}
.video-tile.turn .tile-label { background: #ffd84a; color: #1a1a2e; font-weight: 700; }
.video-tile.out video { filter: grayscale(1) brightness(0.6); }

#display-name-label {
  color: #c8c8e0;
  font-size: 0.9em;
  display: inline-flex;
  align-items: center;
  gap: 0.4em;
}
#display-name-input {
  background: #20203a;
  color: #e8e8ff;
  border: 1px solid #5050a0;
  border-radius: 5px;
  padding: 0.3em 0.5em;
  font: inherit;
  width: 10em;
}

.room-badge {
  font-family: monospace;
  background: #2a2a50;
  color: #a0a0ff;
  padding: 0.2em 0.6em;
  border-radius: 4px;
  font-size: 0.95em;
}

#copy-link-btn,
.share-link-btn {
  background: #3a3a70;
  color: #c8c8ff;
  border: 1px solid #5050a0;
  padding: 0.35em 0.9em;
  border-radius: 5px;
  cursor: pointer;
  font-size: 0.9em;
  transition: background 0.15s;
  text-decoration: none;
  display: inline-block;
}
#copy-link-btn:hover,
.share-link-btn:hover { background: #4a4a90; }

</style>
{{ if .IsDice }}
<link rel="stylesheet" href="/css/games.css">
<link rel="stylesheet" href="/css/games-pushluck.css">
<link rel="stylesheet" href="/css/games-bluff.css">
<link rel="stylesheet" href="/css/games-boards.css">
<link rel="stylesheet" href="/css/games-category.css">
{{ end }}{{ end }}

{{ define "main" }}
<div id="video-room-header">
  <span>Room: <span class="room-badge">{{ .RoomID }}</span></span>
  <button id="copy-link-btn">Copy Link</button>
  <button id="share-sms-btn" class="share-link-btn" type="button">&#128241; Text Invite</button>
  <label id="display-name-label">
    Your name
    <input id="display-name-input" type="text" maxlength="24" placeholder="Add your name" autocomplete="nickname" />
  </label>
</div>

<div id="video-root" data-room-id="{{ .RoomID }}">
  <div id="video-grid">
    <div class="video-tile local">
      <video id="local_video" autoplay controls muted playsinline></video>
      <div class="tile-label"></div>
      <div class="tile-badge"></div>
    </div>
    <!-- remote .video-tile elements are appended here by video.js -->
  </div>
</div>

{{ if .IsDice }}
<!-- ── Dice Game Panel ──────────────────────────────── -->
<div id="game-panel">
  <div id="game-header-row">
    <h2>&#127922; Dice Games</h2>
    <label id="game-picker-label" for="game-picker">Game <select id="game-picker"></select></label>
    <span id="game-options"></span>
    <button id="start-game-btn" type="button">Start Game</button>
    <button id="enter-fullscreen-btn" type="button">Fullscreen</button>
    <button id="enable-shake-btn" type="button">Enable Shake-to-Roll</button>
    <span id="game-status" role="status"></span>
    <div id="shake-hint" hidden>
      Firefox uses phone shakes for its own &ldquo;shake to summarize&rdquo;
      feature. To shake-to-roll here, turn that off in Firefox&rsquo;s
      settings &mdash; or just tap Roll.
      <button id="shake-hint-dismiss" type="button">Got it</button>
    </div>
  </div>
  <details id="game-rules">
    <summary>How to play <span id="game-rules-name"></span></summary>
    <p id="game-rules-summary"></p>
    <ul id="game-rules-list"></ul>
    <p class="rules-links">
      <a id="game-rules-page" href="/games/rules" target="_blank" rel="noopener">Full rules from the sheet ↗</a>
      <a id="game-rules-doc" href="#" target="_blank" rel="noopener" hidden>Rules document ↗</a>
      <a href="/games/rules" target="_blank" rel="noopener">All games ↗</a>
    </p>
  </details>
  <div id="game-player-list"></div>
  <button id="exit-fullscreen-btn" type="button" title="Show videos">&#9166;</button>
  <div id="game-state-panel" style="display:none;">
    <div id="game-state-message">
      <div id="turn-banner-title"></div>
      <div id="turn-banner-detail"></div>
    </div>
    <div id="bust-flash" aria-live="assertive"></div>
    <div id="game-board"></div>
    <ol id="game-action-log" aria-live="polite"></ol>
  </div>
</div>
{{ end }}

<script type="text/javascript" src="/js/video.js"></script>
{{ if .IsDice }}
<script type="text/javascript" src="/js/games.js"></script>
<script type="text/javascript" src="/js/games/pig.js"></script>
<script type="text/javascript" src="/js/games/pushluck.js"></script>
<script type="text/javascript" src="/js/games/bluff.js"></script>
<script type="text/javascript" src="/js/games/boards.js"></script>
<script type="text/javascript" src="/js/games/category.js"></script>
<script type="text/javascript" src="/js/games/mice.js"></script>
<script type="text/javascript" src="/js/games/octo.js"></script>
<script type="text/javascript" src="/js/games/doubleorquits.js"></script>
{{ end }}
{{ end }}
